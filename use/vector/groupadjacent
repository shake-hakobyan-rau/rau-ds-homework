#include <iostream>
#include <vector>
#include <cassert>

std::vector<std::vector<int>> groupAdjacent(const std::vector<int>& v) {
    std::vector<std::vector<int>> result;

    if (v.empty()) {
        return result;
    }

    result.push_back({v[0]});

    for (std::size_t i = 1; i < v.size(); ++i) {
        if (v[i] == v[i - 1]) {
            result.back().push_back(v[i]);
        } else {
            result.push_back({v[i]});
        }
    }

    return result;
}

int main() {
    std::vector<int> v = {1, 1, 2, 2, 2, 3, 1};

    std::vector<std::vector<int>> result = groupAdjacent(v);

    assert(result == std::vector<std::vector<int>>({
        {1, 1},
        {2, 2, 2},
        {3},
        {1}
    }));

    return 0;
}