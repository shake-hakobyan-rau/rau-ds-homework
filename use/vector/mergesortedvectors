#include <iostream>
#include <vector>
#include <cassert>

std::vector<int> mergeSortedVectors(const std::vector<int>& a, const std::vector<int>& b) {
    std::vector<int> result;
    std::size_t i = 0;
    std::size_t j = 0;

    while (i < a.size() && j < b.size()) {
        if (a[i] <= b[j]) {
            result.push_back(a[i]);
            ++i;
        } else {
            result.push_back(b[j]);
            ++j;
        }
    }

    while (i < a.size()) {
        result.push_back(a[i]);
        ++i;
    }

    while (j < b.size()) {
        result.push_back(b[j]);
        ++j;
    }

    return result;
}

int main() {
    std::vector<int> a = {1, 3, 5};
    std::vector<int> b = {2, 4, 6};

    std::vector<int> result = mergeSortedVectors(a, b);

    assert(result == std::vector<int>({1, 2, 3, 4, 5, 6}));

    return 0;
}