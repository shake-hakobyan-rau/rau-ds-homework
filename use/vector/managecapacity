#include <iostream>
#include <vector>
#include <cassert>

void manageCapacity(std::vector<int>& v) {
    std::cout << "Size: " << v.size() << '\n';
    std::cout << "Capacity: " << v.capacity() << '\n';

    v.reserve(v.size() + 500);

    for (int i = 1; i <= 500; ++i) {
        v.push_back(i);
    }

    std::cout << "Size: " << v.size() << '\n';
    std::cout << "Capacity: " << v.capacity() << '\n';
}

int main() {
    std::vector<int> v;

    manageCapacity(v);

    assert(v.size() == 500);
    assert(v[0] == 1);
    assert(v[499] == 500);

    return 0;
}