#include <iostream>
using namespace std;

struct TreeNode {
    int val;
    TreeNode* left;
    TreeNode* right;

    TreeNode(int x) {
        val = x;
        left = nullptr;
        right = nullptr;
    }
};

int countNodesAtDepth(TreeNode* root, int k) {
    if (root == nullptr || k < 1)
        return 0;

    if (k == 1)
        return 1;

    return countNodesAtDepth(root->left, k - 1) +
           countNodesAtDepth(root->right, k - 1);
}

