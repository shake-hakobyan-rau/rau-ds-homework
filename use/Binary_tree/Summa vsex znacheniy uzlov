#include <iostream>
using namespace std;

struct TreeNode {
    int val;
    TreeNode* left;
    TreeNode* right;

    TreeNode(int x) {
        val = x;
        left = nullptr;
        right = nullptr;
    }
};

int sumNodes(TreeNode* root) {
    if (root == nullptr) {
        return 0;
    }

    return root->val + sumNodes(root->left) + sumNodes(root->right);
}

