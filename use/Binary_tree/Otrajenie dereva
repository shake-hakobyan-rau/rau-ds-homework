#include <iostream>
using namespace std;

struct TreeNode {
    int val;
    TreeNode* left;
    TreeNode* right;

    TreeNode(int x) {
        val = x;
        left = nullptr;
        right = nullptr;
    }
};

void mirrorTree(TreeNode* root) {
    if (root == nullptr)
        return;

    swap(root->left, root->right);

    mirrorTree(root->left);
    mirrorTree(root->right);
}
int main() {
    return 0;
