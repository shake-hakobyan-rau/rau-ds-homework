#include <iostream>
#include <vector>
#include <string>
using namespace std;

template <typename T>
int linearSearch(const vector<T>& arr, const T& value) {
    for (int i = 0; i < arr.size(); i++) {
        if (arr[i] == value) {
            return i;
        }
    }
    return -1;
}

int main() {
    vector<int> numbers = {10, 20, 30, 20, 40};
    vector<double> doubles = {1.1, 2.2, 3.3, 4.4};
    vector<string> words = {"cat", "dog", "apple", "dog"};

    cout << linearSearch(numbers, 20) << endl;
    cout << linearSearch(doubles, 3.3) << endl;
    cout << linearSearch(words, string("dog")) << endl;

    return 0;
}